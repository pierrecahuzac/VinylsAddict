# General configuration
NODE_ENV=
FRONTEND_URL=

# Database configuration
DATABASE_URL=
POSTGRES_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Security and Authentication
JWT_SECRET=
AUTHORIZED_IPS=
DEV_USER_PASSWORD=

# Discogs API configuration
DISCOGS_USER_AGENT=VinylsAddict/1.0
DISCOGS_TOKEN=votre_token_personnel_discogs 

# Password reset (SMTP)
# Sans SMTP_HOST, le lien est affiché dans les logs de l'API (développement uniquement).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@partagetacollection.eu

NODE_ENV=development
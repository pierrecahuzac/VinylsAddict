# ============================================
# Vinyls Addict — Configuration unique (.env)
# Copier : cp .env.example .env puis éditer
# Utilisé par docker-compose + API + front + landing
# ============================================

# --- General ---
NODE_ENV=production
FRONTEND_URL=https://app.partagetacollection.eu
API_URL=https://api.partagetacollection.eu
PUBLIC_APP_URL=https://partagetacollection.eu

# --- Database (conteneur "db" dans docker-compose) ---
DATABASE_URL=postgresql://postgres:<MOT_DE_PASSE>@db:5432/vinyls_addict
POSTGRES_URL=postgresql://postgres:<MOT_DE_PASSE>@db:5432/vinyls_addict
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<MOT_DE_PASSE>
POSTGRES_DB=vinyls_addict

# --- Security & Auth ---
JWT_SECRET=<SECRET_ALATOIRE>
AUTHORIZED_IPS=
DEV_USER_PASSWORD=<MOT_DE_PASSE>
PROD_SYSTEM_PASSWORD=<MOT_DE_PASSE>
SYSTEM_USER_EMAIL=system@va.eu
SYSTEM_USERNAME=Système

# --- Discogs API ---
DISCOGS_USER_AGENT=VinylsAddict/1.0
DISCOGS_TOKEN=<TOKEN_DISCOGS>

# --- Frontend build (Vite) ---
VITE_BACKEND_URL_DEV=https://api.partagetacollection.eu/api

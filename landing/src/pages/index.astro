---
import Base from "../layouts/Base.astro";
const appUrl = import.meta.env.PUBLIC_APP_URL || "https://app.vinyls-addict.eu";
---
<Base>
  <header class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-4 sm:py-6 flex justify-between items-center gap-3 border-b border-white/10">
    <div class="flex items-center gap-2 sm:gap-3 min-w-0">
      <div class="text-brand font-black italic text-lg sm:text-xl tracking-tighter select-none shrink-0">V<span class="text-white">A</span></div>
      <span class="hidden sm:inline font-bold tracking-tight text-sm sm:text-base truncate">Vinyls Addict</span>
    </div>
    <a href={`${appUrl}/login`} class="text-xs sm:text-sm bg-brand text-white px-3 sm:px-4 py-2 rounded-full font-bold hover:bg-[#7c3aed] transition whitespace-nowrap shrink-0">Se connecter →</a>
  </header>

  <main class="flex-1">
    <!-- Hero -->
    <section class="max-w-6xl mx-auto px-6 py-16 md:py-24 grid md:grid-cols-2 gap-10 items-center">
      <div>
        <p class="text-brand font-bold text-xs tracking-widest uppercase mb-3">Catalogue • Collection • Liste de souhaits</p>
        <h1 class="text-4xl md:text-5xl font-black leading-tight">Votre collection de vinyles,<br/>enfin rangée.</h1>
        <p class="mt-4 text-gray-400 leading-relaxed">Cataloguez vos vinyles, suivez vos prix, états et photos. Catalogue communautaire, collection privée et liste de souhaits.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`${appUrl}`} class="bg-brand text-white px-6 py-3 rounded-full font-black hover:bg-[#7c3aed] transition">Ouvrir l'app →</a>
          <a href={`${appUrl}/login`} class="bg-white/5 border border-white/10 text-white px-6 py-3 rounded-full font-bold hover:bg-white/10 transition">Créer un compte</a>
        </div>
      </div>
      <div class="relative">
        <div class="aspect-[4/3] rounded-[2rem] bg-gradient-to-br from-[#1a1a1a] to-[#0a0a0a] border border-white/10 p-6 flex flex-col justify-between">
          <div class="flex gap-3 items-center min-w-0">
            <img src="https://static.fnac-static.com/multimedia/Images/FR/NR/d8/df/fe/16703448/1507-1/tsp20231221131222/Slaughter-Of-The-Soul-Edition-Limitee.jpg" alt="Slaughter of the Soul - At The Gates" class="w-20 h-20 rounded-xl object-cover shrink-0 border border-white/10" loading="eager" />
            <div class="min-w-0 flex-1">
              <div class="font-bold leading-tight truncate">Slaughter of the Soul</div>
              <div class="text-sm text-gray-400 truncate">At The Gates • 1995</div>
              <div class="text-xs text-brand truncate">12" LP • rock</div>
            </div>
          </div>
          <div class="bg-black/60 rounded-xl p-4 border border-white/10">
            <div class="text-xs text-gray-500 uppercase tracking-widest">Aperçu app</div>
            <div class="mt-2 h-2 bg-brand rounded w-2/3"></div>
            <div class="mt-2 h-2 bg-white/10 rounded w-1/2"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 points -->
    <section class="max-w-6xl mx-auto px-6 py-12 grid md:grid-cols-3 gap-6">
      <div class="bg-white/5 rounded-2xl p-6 border border-white/10">
        <h3 class="font-bold">Catalogue partagé</h3>
        <p class="text-sm text-gray-400 mt-2">Parcourez les pressages, découvrez les pochettes, les genres et les années. Chaque vinyle ajouté enrichit la discothèque commune.</p>
      </div>
      <div class="bg-white/5 rounded-2xl p-6 border border-white/10">
        <h3 class="font-bold">Collection privée</h3>
        <p class="text-sm text-gray-400 mt-2">Suivez vos exemplaires : prix, état, notes et photos. Votre collection reste personnelle et organisée.</p>
      </div>
      <div class="bg-white/5 rounded-2xl p-6 border border-white/10">
        <h3 class="font-bold">Liste de souhaits</h3>
        <p class="text-sm text-gray-400 mt-2">Gardez vos envies sous le coude. Ajoutez vos prochains vinyles et retrouvez-les en un clic.</p>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-6 py-12 text-center border-t border-white/10 mt-6">
      <h2 class="text-2xl font-black">Prêt à compléter votre collection ?</h2>
      <p class="mt-2 text-gray-400 text-sm">Votre prochain vinyle n'attend que d'être ajouté à votre discothèque.</p>
      <a href={`${appUrl}`} class="inline-block mt-6 bg-brand text-white px-8 py-4 rounded-full font-black hover:bg-[#7c3aed] transition">Ouvrir l'app →</a>
    </section>
  </main>
</Base>
